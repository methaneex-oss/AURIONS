{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "event-registry.v1.schema.json",
  "title": "AURIONS event registry",
  "description": "Machine-readable inventory of versioned event names and exact payload-schema/fixture bindings. Entries are design-only and cannot be dispatched until handler, consumer, transition, authorization and runtime validation contracts are complete.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "registry_id",
    "registry_version",
    "status",
    "source_catalogue",
    "events"
  ],
  "properties": {
    "registry_id": {
      "const": "aurions.event-registry"
    },
    "registry_version": {
      "const": "1.0"
    },
    "status": {
      "const": "design_baseline_not_dispatchable"
    },
    "source_catalogue": {
      "type": "string",
      "minLength": 1
    },
    "events": {
      "type": "object",
      "minProperties": 89,
      "propertyNames": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9_.]+\\.v1$"
      },
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "event_version",
          "payload_schema_ref",
          "fixture_refs",
          "dispatch_status",
          "unresolved_bindings",
          "command_producers",
          "command_producer_binding_status",
          "producer_origin",
          "producer_trigger_contract",
          "owning_component",
          "consumer_contracts",
          "owner_transition_contract",
          "consumer_transition_summary",
          "ordering_idempotency_contract",
          "failure_recovery_contract",
          "acceptance_scenario_refs",
          "specification_status"
        ],
        "properties": {
          "event_version": {
            "const": "1.0"
          },
          "payload_schema_ref": {
            "type": "string",
            "minLength": 1
          },
          "fixture_refs": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "dispatch_status": {
            "const": "design_only_not_dispatchable"
          },
          "unresolved_bindings": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "command_producers": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "command_producer_binding_status": {
            "enum": [
              "bound",
              "unresolved"
            ]
          },
          "producer_origin": {
            "enum": [
              "command",
              "owner_governance_interface",
              "platform_provider_ingress",
              "artifact_registry",
              "memory_consolidation",
              "egress_governance",
              "retention_worker",
              "action_gateway_internal_transition",
              "governance_evaluator",
              "observation_ingress",
              "learning_supervisor",
              "self_model_manager",
              "evolution_manager",
              "sync_engine",
              "worker_supervisor",
              "scheduler_internal_transition",
              "owning_domain_internal_transition"
            ]
          },
          "producer_trigger_contract": {
            "type": "string",
            "minLength": 20
          },
          "owning_component": {
            "type": "string",
            "minLength": 3
          },
          "consumer_contracts": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "component",
                "purpose"
              ],
              "properties": {
                "component": {
                  "type": "string",
                  "minLength": 3
                },
                "purpose": {
                  "type": "string",
                  "minLength": 20
                }
              }
            }
          },
          "owner_transition_contract": {
            "type": "string",
            "minLength": 30
          },
          "consumer_transition_summary": {
            "type": "string",
            "minLength": 30
          },
          "ordering_idempotency_contract": {
            "type": "string",
            "minLength": 30
          },
          "failure_recovery_contract": {
            "type": "string",
            "minLength": 30
          },
          "acceptance_scenario_refs": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^(INT|CM|AD)-[0-9]{3}$"
            }
          },
          "specification_status": {
            "const": "specified_not_runtime_validated"
          }
        }
      }
    }
  }
}
