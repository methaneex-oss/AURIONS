{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:aurions:first-release-command-query-scope-d04-v1",
  "title": "AURIONS D-04 Owner-Accepted First-Release Command and Query Scope",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "registry_id",
    "registry_version",
    "status",
    "owner_decision",
    "owner_accepted_at",
    "source_refs",
    "authority_boundary",
    "dispatch_invariant",
    "commands",
    "queries"
  ],
  "properties": {
    "registry_id": {
      "const": "aurions.first-release-command-query-scope.d04"
    },
    "registry_version": {
      "const": "1.0"
    },
    "status": {
      "const": "owner_accepted_scope_only"
    },
    "owner_decision": {
      "const": "D-04"
    },
    "owner_accepted_at": {
      "type": "string",
      "format": "date"
    },
    "source_refs": {
      "type": "array",
      "minItems": 2,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "authority_boundary": {
      "type": "string",
      "minLength": 80
    },
    "dispatch_invariant": {
      "type": "string",
      "minLength": 50
    },
    "commands": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "p0_public_owner_facing",
        "p0_internal_protected",
        "p1_conditional",
        "internal_maintenance_optional",
        "deferred"
      ],
      "properties": {
        "p0_public_owner_facing": {
          "type": "array",
          "minItems": 27,
          "maxItems": 27,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 3,
            "maxLength": 128,
            "pattern": "^[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*)+$"
          }
        },
        "p0_internal_protected": {
          "type": "array",
          "minItems": 14,
          "maxItems": 14,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 3,
            "maxLength": 128,
            "pattern": "^[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*)+$"
          }
        },
        "p1_conditional": {
          "type": "array",
          "minItems": 9,
          "maxItems": 9,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 3,
            "maxLength": 128,
            "pattern": "^[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*)+$"
          }
        },
        "internal_maintenance_optional": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 3,
            "maxLength": 128,
            "pattern": "^[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*)+$"
          }
        },
        "deferred": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 3,
            "maxLength": 128,
            "pattern": "^[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*)+$"
          }
        }
      }
    },
    "queries": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "p0_read_only",
        "p1_conditional",
        "internal_diagnostic"
      ],
      "properties": {
        "p0_read_only": {
          "type": "array",
          "minItems": 18,
          "maxItems": 18,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 3,
            "maxLength": 128,
            "pattern": "^[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*)+$"
          }
        },
        "p1_conditional": {
          "type": "array",
          "minItems": 6,
          "maxItems": 6,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 3,
            "maxLength": 128,
            "pattern": "^[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*)+$"
          }
        },
        "internal_diagnostic": {
          "type": "array",
          "minItems": 5,
          "maxItems": 5,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 3,
            "maxLength": 128,
            "pattern": "^[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*)+$"
          }
        }
      }
    }
  }
}
